# Example Caddyfile configuration for your host's global Caddy:
# (Replace dl.yourdomain.com with your actual public domain)

dl.yourdomain.com {
    encode zstd gzip

    # Unbuffered streaming reverse proxy to mtflux
    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
    }

    log {
        output stdout
        format console
    }
}
