# ==============================================================================
# mtflux Configuration Template
# ==============================================================================

# --- Telegram API Credentials (https://my.telegram.org) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Bot Credentials (https://t.me/BotFather) ---
# Primary bot for handling user updates and control commands
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Additional worker bots for chunk striping (comma-separated, at least 1-7 workers recommended)
WORKER_TOKENS=234567890:BCDEfGhIJKlmNoPQRsTUVwxyZA,345678901:CDEFgHIjKlMnOpQrStUvWxYzB

# Whether main bot also acts as a download worker
INCLUDE_MAIN_AS_WORKER=true

# --- Storage & Log Channel ---
# The ID of your private log channel where all media is archived (e.g. -1001234567890)
# IMPORTANT: All worker bots AND main bot must be added as channel Administrators!
LOG_CHANNEL_ID=-1001234567890

# --- Security & Public URL ---
# Cryptographic secret used to sign HMAC-SHA256 download tokens (keep this secret!)
# Rotating this secret revokes all existing download links immediately.
LINK_SECRET=change-this-to-a-secure-random-32-byte-hex-string

# Public domain or base URL delivered in Telegram replies
PUBLIC_URL=https://dl.yourdomain.com
PUBLIC_DOMAIN=dl.yourdomain.com

# --- HTTP Server ---
HTTP_ADDR=:8080

# --- Speed Profile & Performance Tuning ---
# Available profiles:
#   - safe:    M=2 conns/bot/dc, window_max=4  (Official Telegram level)
#   - fast:    M=4 conns/bot/dc, window_max=16 (Default, balanced multi-bot performance)
#   - extreme: M=8 conns/bot/dc, window_max=32 (Maximum throughput, Nekogram-style)
SPEED_PROFILE=fast

# Optional granular overrides (leave 0 or unset to inherit from profile):
# CONNS_PER_BOT_PER_DC=4
# STREAM_WINDOW_MAX=16
# STREAM_WINDOW_MIN=4
# STREAM_MAX_BOTS=0 # 0 = stripe across all available workers

# --- Memory & Buffering ---
MAX_BUFFER_MB=1024
CHUNK_CACHE_MB=256
CHUNK_SIZE=1048576

# --- Concurrency & Stream Caps ---
MAX_STREAMS_PER_IP=16
MAX_ACTIVE_STREAMS=500

# --- Access Control & Link TTL ---
# Access mode: 'public' (anyone can use bot) or 'private' (admins/allowed only)
ACCESS_MODE=public

# Telegram User ID of the owner
OWNER_ID=123456789

# Comma-separated admin Telegram IDs
ADMIN_IDS=123456789

# Comma-separated allowed user Telegram IDs (used if ACCESS_MODE=private)
ALLOWED_USERS=

# Default link TTL duration (e.g. 0s = never expires, 6h, 24h, 7d)
DEFAULT_LINK_TTL=0s

# --- State Directory ---
DATA_DIR=/data

# --- Metrics (Prometheus /metrics) ---
# Optional Bearer token for protecting /metrics endpoint
METRICS_AUTH_TOKEN=
